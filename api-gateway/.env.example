# API Gateway environment template
PORT=3000
JWT_SECRET=replace_with_secure_secret_at_least_32_chars
USER_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:4002
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Cloud deployments (Vercel gateway + Railway services):
# shared secret sent to backend services as x-internal-api-key.
# Set the SAME value on user-service and notification-service.
# Leave empty for local/docker-compose (network isolation is enough there).
INTERNAL_API_KEY=
# Proxy hops to trust for X-Forwarded-For (1 = container/LB, 2 = Vercel)
TRUST_PROXY=1
# Allowed browser origin for CORS (e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=
LOG_LEVEL=info
