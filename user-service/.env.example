# User Service environment template
PORT=4001
JWT_SECRET=replace_with_secure_secret_at_least_32_chars
MONGO_URI=mongodb://localhost:27017/users
NATS_URL=nats://localhost:4222
NATS_USER=appuser
NATS_PASSWORD=change_this_strong_password
# Optional: when set, only requests carrying x-internal-api-key (the gateway)
# are accepted. Leave empty for local/docker-compose. Use the same value on
# api-gateway when services have public URLs (Railway/Vercel hybrid).
INTERNAL_API_KEY=
LOG_LEVEL=info
