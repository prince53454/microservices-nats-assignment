# Root environment template — consumed by docker-compose.yml
# (per-service .env files are only needed when running services on the host;
#  containers take their config from compose `environment:` blocks)

# Strong password for the NATS appuser (nats/nats.conf substitutes it via $(NATS_PASSWORD))
NATS_PASSWORD=change_this_strong_password

# Shared JWT secret — MUST be identical in api-gateway and user-service.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_very_long_random_secret_at_least_32_chars

# Public port of the API Gateway on the host
GATEWAY_PORT=3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Cloud hybrid deployments only (Vercel gateway + Railway services):
# shared secret for x-internal-api-key between gateway and services.
# Not wired into docker-compose (network isolation replaces it there).
# INTERNAL_API_KEY=openssl_rand_hex_32_output
